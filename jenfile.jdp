
pipeline {
    agent any

    stages {
        stage('Code Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/BhaveshJ18/student-3TIER.git'

                echo 'Code cloned successfully'
            }
        }
    stage('backend-image-build') {
            steps {
               sh '''cd backend 
                docker build -t backend:latest .'''
            }
        }
    stage ('frontend-image-build') {
            steps {
            sh '''cd frontend
            docker build -t frontend:latest .'''
          }  
      }
   stage('BACKEND-CONT') {
            steps {
                sh '''
                     docker run -d -p 8081:8081 --name backend --network=net1 backend:latest
                                '''
         }
      }
stage('FRONTEND-CONT') {
            steps {
               sh '''docker stop frontend
                   docker rm frontend
                     docker run -d -p 80:80 --name frontend --network=net1 frontend:latest
                                '''
                echo 'APP Build-Deploy successfull'
         }
       }
   }
}

pipeline {
    agent {
        docker {
            image 'maven:3.9.9-eclipse-temurin-17'
            label 'docker-agent'
        }
    }

    stages {
        stage('Check Java') {
            steps {
                sh 'java -version'
            }
        }

        stage('Check Maven') {
            steps {
                sh 'mvn -version'
            }
        }

        stage('Check Workspace') {
            steps {
                sh 'pwd'
                sh 'ls -la'
            }
        }
    }
}

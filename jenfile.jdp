pipeline {
    agent any

    stages {
        stage('Code Clone') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/vishuanjali/EasyCRUD.git'

                echo 'Code cloned successfully'
            }
        }

        stage('Build') {
            steps {
                sh '''
                    cd backend
                    mvn clean package -DskipTests
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    cd backend
                    mvn test
                '''
                echo 'Tests completed successfully'
            }
        }
        
        stage('Deploy') {
            steps {
                 sh 'aws s3 cp backend/target/student-registration-backend-0.0.1-SNAPSHOT.jar s3://easy-cccrud-2028/'
                echo 'application deploy successfull'
            }
        }

        stage('Monitor') {
            steps {
                echo 'Monitoring stage completed'
            }
        }
    }
}
